{
  "name": "kamo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kamo - multi-tenant booking calendar for sound reinforcement gear",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.3"
  }
}
